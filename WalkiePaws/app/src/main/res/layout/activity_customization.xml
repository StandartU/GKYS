<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#c4e1ed">

    <ImageView
        android:id="@+id/imageBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/block_exit" />

    <ImageView
        android:id="@+id/customizationHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imageBack"
        android:contentDescription="@null"
        app:srcCompat="@drawable/block_customization" />

    <LinearLayout
        android:id="@+id/categoriesContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/customizationHeader"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="15dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <TextView
            android:id="@+id/hatsCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/category_button_selected"
            android:gravity="center"
            android:text="Головные уборы"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topsCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/category_button"
            android:gravity="center"
            android:text="Верхняя одежда"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accessoriesCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/category_button"
            android:gravity="center"
            android:text="Аксессуары"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/itemsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/categoriesContainer"
        android:layout_marginTop="-5dp"
        android:paddingHorizontal="15dp">

        <LinearLayout
            android:id="@+id/itemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/style_shop_tovar"
            android:orientation="vertical"
            android:padding="15dp">

        </LinearLayout>
    </ScrollView>
</RelativeLayout>