<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#c4e1ed"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textNameGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="100dp"
        android:text="@string/app_name"
        android:textColor="@color/main_color_auth"
        android:textSize="50sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textAuthorization"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="9dp"
        android:text="@string/auth"
        android:textColor="@color/main_color_auth"
        android:textSize="35sp" />

    <EditText
        android:id="@+id/editTextWriteLogin"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_marginTop="90dp"
        android:importantForAutofill="no"
        android:ems="10"
        android:textColor="@color/main_color_auth"
        android:hint="@string/write_login"
        android:inputType="text"
        android:textColorHint="@color/main_color_auth"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/editTextWritePassword"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:importantForAutofill="no"
        android:ems="10"
        android:textColor="@color/main_color_auth"
        android:hint="@string/write_password"
        android:inputType="textPassword"
        android:textColorHint="@color/main_color_auth"
        android:textSize="20sp" />

    <Button
        android:id="@+id/buttonLogin"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:backgroundTint="@color/main_color_auth"
        android:text="@string/login"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <Button
        android:id="@+id/buttonRegistration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:backgroundTint="@color/main_color_auth"
        android:text="@string/registration"
        android:textColor="@color/white"
        android:textSize="15sp" />
</LinearLayout>