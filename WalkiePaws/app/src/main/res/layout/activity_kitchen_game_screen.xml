<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kitchen_1"
    tools:context=".main_game.KitchenFragment">

    <!-- Персонаж -->
    <ImageView
        android:id="@+id/imageCharacterKitchen"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="200dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/imageCharacterEatingKitchen"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="200dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Шапка -->
    <ImageView
        android:id="@+id/hatImageKitchen"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignBottom="@id/imageCharacterKitchen"
        android:layout_alignStart="@id/imageCharacterKitchen"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Одежда -->
    <ImageView
        android:id="@+id/topImageKitchen"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignBottom="@id/imageCharacterKitchen"
        android:layout_alignStart="@id/imageCharacterKitchen"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Аксессуар -->
    <ImageView
        android:id="@+id/accessoryImageKitchen"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignBottom="@id/imageCharacterKitchen"
        android:layout_alignStart="@id/imageCharacterKitchen"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Шапка -->
    <ImageView
        android:id="@+id/hatImageKitchenEating"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignBottom="@id/imageCharacterKitchen"
        android:layout_alignStart="@id/imageCharacterKitchen"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Одежда -->
    <ImageView
        android:id="@+id/topImageKitchenEating"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignBottom="@id/imageCharacterKitchen"
        android:layout_alignStart="@id/imageCharacterKitchen"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Аксессуар -->
    <ImageView
        android:id="@+id/accessoryImageKitchenEating"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_alignBottom="@id/imageCharacterKitchen"
        android:layout_alignStart="@id/imageCharacterKitchen"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Стол -->
    <ImageView
        android:id="@+id/imageTable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null" />

    <!-- Кнопка: Еда -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/button_food"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="50dp"
        android:layout_toEndOf="@id/button_shop"
        android:background="@drawable/bg_icon"
        android:scaleType="centerInside"
        android:src="@drawable/icon_food"
        app:shapeAppearanceOverlay="@style/Circular" />

    <!-- Popup для выбора еды -->
    <RelativeLayout
        android:id="@+id/foodPopup"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_above="@id/button_food"
        android:layout_alignEnd="@id/button_food"
        android:layout_marginBottom="30dp"
        android:background="@drawable/style_shop_tovar"
        android:visibility="gone"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/closeFoodPopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="220dp"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/block_exit"
            android:contentDescription="@null" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50dp"
            android:padding="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/foodItemsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </RelativeLayout>

    <!-- Кнопка: Магазин -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/button_shop"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:background="@drawable/bg_icon"
        android:scaleType="centerInside"
        android:src="@drawable/icon_shop"
        app:shapeAppearanceOverlay="@style/Circular" />

    <!-- Кнопка: Кастомизация -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/button_customize"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="50dp"
        android:layout_toStartOf="@id/button_shop"
        android:background="@drawable/bg_icon"
        android:scaleType="centerInside"
        android:src="@drawable/icon_customization"
        app:shapeAppearanceOverlay="@style/Circular" />

</RelativeLayout>
