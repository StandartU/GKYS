<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kitchen_1"
    android:orientation="vertical"
    tools:context=".KitchenGameScreen">

    <ImageView
        android:id="@+id/imageTable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/kitchen_table_1"
        android:contentDescription="@null"/>


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/button_food"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="50dp"
        android:layout_toEndOf="@+id/button_shop"
        android:background="@drawable/image_border"
        android:scaleType="centerInside"
        android:src="@drawable/icon_food"
        app:shapeAppearanceOverlay="@style/Circular" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/button_shop"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:background="@drawable/image_border"
        android:scaleType="centerInside"
        android:src="@drawable/icon_shop"
        app:shapeAppearanceOverlay="@style/Circular" />


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/button_customize"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="50dp"
        android:layout_toStartOf="@+id/button_shop"
        android:background="@drawable/image_border"
        android:scaleType="centerInside"
        android:src="@drawable/icon_customization"
        app:shapeAppearanceOverlay="@style/Circular" />


</RelativeLayout>

