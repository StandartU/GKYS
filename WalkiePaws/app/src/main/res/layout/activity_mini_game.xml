<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#c4e1ed"
    tools:context=".main_game.CustomizationActivity">

    <ImageView
        android:id="@+id/imageBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/block_exit" />

    <ImageView
        android:id="@+id/minigameHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imageBack"
        android:layout_marginTop="15dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/block_mini_game" />


    <ScrollView
        android:id="@+id/itemsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/minigameHeader"
        android:layout_marginTop="5dp"
        android:paddingHorizontal="15dp">

        <LinearLayout
            android:id="@+id/itemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/style_shop_tovar"
            android:orientation="vertical"
            android:padding="15dp">

        </LinearLayout>
    </ScrollView>
</RelativeLayout>