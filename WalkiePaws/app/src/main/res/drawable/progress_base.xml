<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="20dp"/>
            <solid android:color="#C4E1ED"/>
            <stroke android:width="3dp" android:color="#2A5668"/>
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="20dp"/>
                <solid android:color="@color/ddd1"/>
                <stroke android:width="3dp" android:color="@color/ddd"/>
            </shape>
        </clip>
    </item>

</layer-list>
