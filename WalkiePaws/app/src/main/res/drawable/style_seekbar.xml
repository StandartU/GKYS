<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фон ProgressBar -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="360dp"/>  <!-- Полностью закругленные углы -->
            <solid android:color="@color/white"/>    <!-- Светло-серый фон -->
        </shape>
    </item>

    <!-- Основной прогресс -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="360dp"/>  <!-- Такие же закругленные углы как у фона -->
                <solid android:color="@color/seekbarbg"/>   <!-- Зеленый цвет прогресса -->
            </shape>
        </clip>
    </item>

</layer-list>