<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фон прогрессбара -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="20dp"/>
            <solid android:color="#C4E1ED"/> <!-- Цвет фона -->
            <stroke android:width="3dp" android:color="#2A5668"/> <!-- Цвет границы фона -->
        </shape>
    </item>

    <!-- Обводка прогресса -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="20dp"/>
                <solid android:color="@android:color/transparent"/> <!-- Прозрачный фон -->
                <stroke android:width="3dp" android:color="#2A5668"/> <!-- Цвет границы прогресса -->
            </shape>
        </clip>
    </item>

    <!-- Прогресс, который будет уменьшаться -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="20dp"/> <!-- Закругленные края -->
                <solid android:color="#F9C54E"/> <!-- Цвет прогресса по умолчанию -->
                <stroke android:width="3dp" android:color="#C8744E"/> <!-- Цвет границы прогресса -->
            </shape>
        </clip>
    </item>
</layer-list>
